{
    "name": "blissjaspis/laravel-midtrans",
    "description": "Laravel Midtrans",
    "type": "library",
    "version": "2.1.0",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.4 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "BlissJaspis\\Midtrans\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workbench\\App\\": "workbench/app/",
            "BlissJaspis\\Midtrans\\Tests\\": "tests/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "test": "@php vendor/bin/pest",
        "format": "vendor/bin/pint",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi"
        ]
    },
    "authors": [
        {
            "name": "Bliss Jaspis",
            "email": "jaspis_zzt@ymail.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BlissJaspis\\Midtrans\\Providers\\MidtransServiceProvider"
            ],
            "aliases": {
                "Midtrans": "BlissJaspis\\Midtrans\\Facades\\Midtrans"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
